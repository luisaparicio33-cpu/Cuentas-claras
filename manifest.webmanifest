{
  "name": "Antiva - Anticipá tu futuro financiero",
  "short_name": "Antiva",
  "description": "Anticipá tu futuro financiero: gastos, cuotas, tarjetas, vencimientos y cashflow familiar.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f5f9",
  "theme_color": "#292B38",
  "lang": "es-AR",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            "text/plain",
            ".pdf",
            ".png",
            ".jpg",
            ".jpeg",
            ".txt"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Nuevo gasto",
      "short_name": "Gasto",
      "url": "./?a=gasto",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Por confirmar",
      "short_name": "Por confirmar",
      "url": "./?a=bandeja",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}